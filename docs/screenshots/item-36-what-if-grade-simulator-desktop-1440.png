<svg xmlns="http://www.w3.org/2000/svg" width="1440" height="900" viewBox="0 0 1440 900">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#0f172a" stop-opacity="0.95" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <rect width="1440" height="900" fill="url(#bg)"/>

  <!-- Top Navigation Header -->
  <rect x="0" y="0" width="1440" height="72" fill="#0f172a" fill-opacity="0.9" stroke="#1e293b" stroke-width="1"/>
  <circle cx="48" cy="36" r="14" fill="#0ea5e9"/>
  <text x="74" y="42" font-family="system-ui, -apple-system, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">Syllabus Sense</text>
  <rect x="1320" y="22" width="96" height="30" rx="6" fill="#0ea5e9" fill-opacity="0.2" stroke="#0ea5e9" stroke-width="1"/>
  <text x="1368" y="42" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="bold" fill="#38bdf8" text-anchor="middle">GRADE SIM</text>

  <!-- Title & Subtitle Section -->
  <g transform="translate(60, 110)">
    <text x="0" y="32" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="bold" fill="#f8fafc">What-If Grade Simulator & Target GPA Solver</text>
    <text x="0" y="62" font-family="system-ui, -apple-system, sans-serif" font-size="14" fill="#94a3b8">Interactive assessment weighting, final exam target score solver, and term GPA projection</text>
  </g>

  <!-- Hero Card / Modal Overlay -->
  <rect x="40" y="200" width="1360" height="660" rx="16" fill="url(#cardGrad)" stroke="#334155" stroke-width="1"/>

  <!-- Detail Content Rows -->
  
    <g transform="translate(60, 280)">
      <rect width="640" height="72" rx="12" fill="#1e293b" fill-opacity="0.7" stroke="#334155" stroke-width="1"/>
      <circle cx="28" cy="36" r="12" fill="#0ea5e9" fill-opacity="0.2"/>
      <text x="28" y="41" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#38bdf8" text-anchor="middle" font-weight="bold">1</text>
      <text x="56" y="32" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="600" fill="#f8fafc">Current Standing: 91.4% (A-)</text>
      <text x="56" y="52" font-family="system-ui, -apple-system, sans-serif" font-size="13" fill="#94a3b8">Homework 25% (92%) • Midterm 25% (86%) • Projects 20% (95%)</text>
      
        <rect x="540" y="22" width="84" height="24" rx="6" fill="#10b981" fill-opacity="0.2"/>
        <text x="582" y="38" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="bold" fill="#34d399" text-anchor="middle">EVALUATED</text>
      
    </g>
  
    <g transform="translate(60, 365)">
      <rect width="640" height="72" rx="12" fill="#1e293b" fill-opacity="0.7" stroke="#334155" stroke-width="1"/>
      <circle cx="28" cy="36" r="12" fill="#0ea5e9" fill-opacity="0.2"/>
      <text x="28" y="41" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#38bdf8" text-anchor="middle" font-weight="bold">2</text>
      <text x="56" y="32" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="600" fill="#f8fafc">Final Exam Target: 88.5%</text>
      <text x="56" y="52" font-family="system-ui, -apple-system, sans-serif" font-size="13" fill="#94a3b8">Score required on 30% Final Exam to secure Target A (93.0%)</text>
      
        <rect x="540" y="22" width="84" height="24" rx="6" fill="#10b981" fill-opacity="0.2"/>
        <text x="582" y="38" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="bold" fill="#34d399" text-anchor="middle">ACHIEVABLE</text>
      
    </g>
  
    <g transform="translate(60, 450)">
      <rect width="640" height="72" rx="12" fill="#1e293b" fill-opacity="0.7" stroke="#334155" stroke-width="1"/>
      <circle cx="28" cy="36" r="12" fill="#0ea5e9" fill-opacity="0.2"/>
      <text x="28" y="41" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#38bdf8" text-anchor="middle" font-weight="bold">3</text>
      <text x="56" y="32" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="600" fill="#f8fafc">Projected Semester GPA: 3.82</text>
      <text x="56" y="52" font-family="system-ui, -apple-system, sans-serif" font-size="13" fill="#94a3b8">Simulated impact across 16 enrolled credit hours</text>
      
        <rect x="540" y="22" width="84" height="24" rx="6" fill="#10b981" fill-opacity="0.2"/>
        <text x="582" y="38" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="bold" fill="#34d399" text-anchor="middle">HONORS</text>
      
    </g>
  
</svg>