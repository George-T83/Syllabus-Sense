<svg xmlns="http://www.w3.org/2000/svg" width="375" height="812" viewBox="0 0 375 812">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#0f172a" stop-opacity="0.95" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="15" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <rect width="375" height="812" fill="url(#bg)"/>

  <!-- Top Navigation Header -->
  <rect x="0" y="0" width="375" height="60" fill="#0f172a" fill-opacity="0.9" stroke="#1e293b" stroke-width="1"/>
  <circle cx="28" cy="30" r="14" fill="#0ea5e9"/>
  <text x="50" y="35" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="bold" fill="#ffffff">Syllabus Sense</text>
  <rect x="295" y="18" width="64" height="26" rx="6" fill="#0ea5e9" fill-opacity="0.2" stroke="#0ea5e9" stroke-width="1"/>
  <text x="327" y="35" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="bold" fill="#38bdf8" text-anchor="middle">375px</text>

  <!-- Title & Subtitle Section -->
  <g transform="translate(24, 85)">
    <text x="0" y="32" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="bold" fill="#f8fafc">Workload Radar</text>
    <text x="0" y="55" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#94a3b8">Cognitive Stress Map (375px)</text>
  </g>

  <!-- Hero Card / Modal Overlay -->
  <rect x="16" y="165" width="343" height="625" rx="16" fill="url(#cardGrad)" stroke="#334155" stroke-width="1"/>

  <!-- Detail Content Rows -->
  
    <g transform="translate(24, 220)">
      <rect width="327" height="58" rx="12" fill="#1e293b" fill-opacity="0.7" stroke="#334155" stroke-width="1"/>
      <circle cx="28" cy="29" r="12" fill="#0ea5e9" fill-opacity="0.2"/>
      <text x="28" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#38bdf8" text-anchor="middle" font-weight="bold">1</text>
      <text x="56" y="26" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#f8fafc">Exam Load: 70%</text>
      <text x="56" y="44" font-family="system-ui, -apple-system, sans-serif" font-size="11" fill="#94a3b8">CS 301 Midterm 1</text>
      
        <rect x="247" y="18" width="68" height="24" rx="6" fill="#10b981" fill-opacity="0.2"/>
        <text x="281" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="bold" fill="#34d399" text-anchor="middle">WARNING</text>
      
    </g>
  
    <g transform="translate(24, 290)">
      <rect width="327" height="58" rx="12" fill="#1e293b" fill-opacity="0.7" stroke="#334155" stroke-width="1"/>
      <circle cx="28" cy="29" r="12" fill="#0ea5e9" fill-opacity="0.2"/>
      <text x="28" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#38bdf8" text-anchor="middle" font-weight="bold">2</text>
      <text x="56" y="26" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#f8fafc">Task Volume: 48%</text>
      <text x="56" y="44" font-family="system-ui, -apple-system, sans-serif" font-size="11" fill="#94a3b8">3 pending tasks</text>
      
        <rect x="247" y="18" width="68" height="24" rx="6" fill="#10b981" fill-opacity="0.2"/>
        <text x="281" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="bold" fill="#34d399" text-anchor="middle">OK</text>
      
    </g>
  
    <g transform="translate(24, 360)">
      <rect width="327" height="58" rx="12" fill="#1e293b" fill-opacity="0.7" stroke="#334155" stroke-width="1"/>
      <circle cx="28" cy="29" r="12" fill="#0ea5e9" fill-opacity="0.2"/>
      <text x="28" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#38bdf8" text-anchor="middle" font-weight="bold">3</text>
      <text x="56" y="26" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#f8fafc">Advice</text>
      <text x="56" y="44" font-family="system-ui, -apple-system, sans-serif" font-size="11" fill="#94a3b8">Stagger study runway</text>
      
        <rect x="247" y="18" width="68" height="24" rx="6" fill="#10b981" fill-opacity="0.2"/>
        <text x="281" y="34" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="bold" fill="#34d399" text-anchor="middle">DEFENSE</text>
      
    </g>
  
</svg>