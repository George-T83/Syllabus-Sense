# Environment Variables Template
# Copy this file to .env.local or configure these variables in the Vercel dashboard.

# Next.js Application Environment
NEXT_PUBLIC_APP_ENV=your-value-here

# Firebase Configuration (Client-side / Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your-value-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-value-here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-value-here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-value-here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-value-here
NEXT_PUBLIC_FIREBASE_APP_ID=your-value-here

# Firebase Admin Configuration (Server-side / Private)
FIREBASE_ADMIN_PROJECT_ID=your-value-here
FIREBASE_ADMIN_CLIENT_EMAIL=your-value-here
FIREBASE_ADMIN_PRIVATE_KEY=your-value-here

# Firestore Database Selection
# Selects '(default)' for production or 'staging' for local/preview deployments.
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=your-value-here

# Firebase Emulator Suite Option
# Set to 'true' to run the Local Emulator Suite in local development, or 'false' otherwise.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Anthropic API (Server-side / Private)
# Required for every AI feature (syllabus extraction, AI Copilot chat, course
# summarization). Without it, extraction/summarization requests fail and chat
# silently falls back to a canned offline responder.
ANTHROPIC_API_KEY=your-value-here

# Anthropic Model Overrides (optional)
# Each defaults to claude-sonnet-5 if unset - only set these to pin a
# specific feature to a different model.
SYLLABUS_EXTRACTION_MODEL=your-value-here
SYLLABUS_CHAT_MODEL=your-value-here
COURSE_SUMMARIZATION_MODEL=your-value-here

# AI Usage Cap (optional)
# Every AI-calling route (extract, summarize, chat, cram-plan, flashcards,
# quiz) shares one daily per-user call counter. Defaults to 60/day if unset.
AI_DAILY_CALL_LIMIT=60

# AI Usage Exemptions (optional)
# Comma-separated Firebase UIDs and/or emails that bypass the daily cap
# entirely - for founder/admin testing accounts until real billing exists.
# Not a payment system: this is a deploy-time allowlist, not a "paid plan".
AI_UNLIMITED_UIDS=your-value-here
AI_UNLIMITED_EMAILS=your-value-here

