rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Syllabus files only: a PDF or a Word (.docx) document, up to 10 MB.
    // The type is checked against the contentType the client sets on the
    // upload, which the file proxy never trusts on its own (it re-detects the
    // type from the bytes), so this is a first filter rather than the only one.
    function isSyllabusUpload() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
    }

    match /users/{userId}/syllabi/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && isSyllabusUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
